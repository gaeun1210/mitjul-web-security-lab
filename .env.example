# 밑줄(Mitjul) 환경 변수 예시 파일
# 실제 사용 시 이 파일을 복사해 .env 로 만들고 값을 채우세요:
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 git 에 올라가지 않습니다.
# ※ DB 계정 비밀번호는 이 파일(.env) 한 곳에서만 관리합니다.
#    db/users.sh 가 최초 실행 때 이 값으로 계정을 만들고, 앱도 같은 값으로 접속합니다.
#    값에는 영문/숫자/_ . - 만 쓰세요.

# MariaDB root 비밀번호 (컨테이너 내부 전용)
MARIADB_ROOT_PASSWORD=change_this_root_pw

# 취약 앱이 쓰는 DB 계정 (mitjul_vuln 전용)
VULN_DB_USER=mituser_vuln
VULN_DB_PASS=change_this_vuln_pw

# 보완 앱이 쓰는 DB 계정 (mitjul_secure 전용)
SECURE_DB_USER=mituser_secure
SECURE_DB_PASS=change_this_secure_pw

# 비밀번호 재설정 인증코드를 화면에 표시할지 (메일 발송 기능이 없는 로컬 실습용)
#   false(기본) : 재설정 기능 비활성화 — 공개/배포 환경 권장
#   true        : 로컬에서 재설정 흐름을 시연할 때만
RESET_DEV_MODE=false
